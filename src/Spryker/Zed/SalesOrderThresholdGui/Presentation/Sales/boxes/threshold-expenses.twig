{# @var order \Generated\Shared\Transfer\OrderTransfer #}
{# @var thresholdExpenseType string #}
{% if thresholdExpenseType is defined %}
    {# New optimized approach with ThresholdExpensesSalesOrderDetailDataExpanderPlugin: Direct template rendering without sub-request #}
    {% include '@SalesOrderThresholdGui/Sales/threshold-expenses.twig' with {
        order: order,
        thresholdExpenseType: thresholdExpenseType,
    } only %}
{% else %}
    {# BC: Fallback to sub-request if plugin not registered #}
    {{ render(controller('/sales-order-threshold-gui/sales/threshold-expenses', {
        orderTransfer: order
    })) }}
{% endif %}
